{
  "name": "chunlv-esports",
  "private": true,
  "version": "0.0.0",
  "description": "Chunlv Esports Companion Dispatch Management System",
  "scripts": {
    "dev:web": "pnpm --filter @chunlv/web dev",
    "dev:server": "pnpm --filter @chunlv/server dev",
    "build": "pnpm --filter @chunlv/shared build && pnpm --filter @chunlv/server build && pnpm --filter @chunlv/web build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "db:migrate": "pnpm --filter @chunlv/server db:migrate",
    "db:seed": "pnpm --filter @chunlv/server db:seed",
    "contract": "node scripts/_export_api_contract.mjs",
    "contract:check": "node scripts/_export_api_contract.mjs --check",
    "ui:tokens": "node scripts/_check_ui_tokens.mjs",
    "ui:tokens:check": "node scripts/_check_ui_tokens.mjs --check",
    "loading:check": "node scripts/_check_loading_state.mjs --check",
    "splitting:check": "node scripts/_check_route_splitting.mjs",
    "routes": "node scripts/_export_web_routes.mjs",
    "routes:check": "node scripts/_export_web_routes.mjs --check",
    "css:vars": "node scripts/_export_css_vars.mjs",
    "css:vars:check": "node scripts/_export_css_vars.mjs --check",
    "deploy": "git pull && pnpm install && pnpm --filter @chunlv/shared build && pnpm --filter @chunlv/server build && sudo -n env PM2_HOME=/root/.pm2 pm2 restart chunlv-server --update-env",
    "deploy:full": "git pull && pnpm install && pnpm build && sudo -n env PM2_HOME=/root/.pm2 pm2 restart chunlv-server --update-env"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.5"
  }
}
